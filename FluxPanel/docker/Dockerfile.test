# Development/CI-only Panel test image. Production uses ../Dockerfile.
FROM php:8.3-cli

WORKDIR /var/www/html

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libmariadb-dev libonig-dev libsqlite3-dev libzip-dev unzip \
    && docker-php-ext-install bcmath mbstring pdo_mysql pdo_sqlite zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY . .
RUN composer install --no-interaction --prefer-dist --optimize-autoloader

CMD ["php", "artisan", "test"]
