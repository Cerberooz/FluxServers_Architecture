# FluxWeb configuration.
#
# Copy to .env and fill in. run.ps1 / run.sh generate SECRET_KEY and
# ENCRYPTION_KEY for you on first run.
#
# NEVER commit .env. The application refuses to start in production when a
# security-critical value is missing or left at a known default.

# --- Core ---------------------------------------------------------------
# production | development | testing
FLASK_ENV=development

# Signs session cookies. Anyone who knows this can forge any session,
# including admin. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Encrypts stored game-panel credentials. Separate from SECRET_KEY so either
# can be rotated independently. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Public origin, used to build verification and payment return links.
BASE_URL=https://fluxservers.cloud

# --- Database (PostgreSQL / Supabase) -----------------------------------
#
# TWO connection strings. Supabase gives you both under
# Project Settings > Database > Connection string.
#
# DATABASE_URL — runtime. Use the TRANSACTION POOLER (port 6543). Serverless
#   opens many short-lived connections and would otherwise exhaust the limit.
#   Format:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# DIRECT_URL — schema changes only. Use the SESSION POOLER (port 5432) or the
#   direct connection. The transaction pooler hands out a different backend per
#   transaction and cannot run migrations reliably; the app refuses to start in
#   production if DATABASE_URL is a transaction pooler and this is unset.
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# sslmode=require is added automatically for any non-local host.
DATABASE_URL=
DIRECT_URL=

# --- Authentication (Supabase Auth) -------------------------------------
# Supabase owns credentials, confirmation emails, and password resets.
# From Project Settings > API.
#
# Defaults to the Supabase backend whenever URL + ANON_KEY are both set;
# falls back to local passwords for development. Production REQUIRES supabase.
# AUTH_BACKEND=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bypasses Row Level Security and can act as any user. Server-side only,
# never in a browser. Used by `flask create-admin` and the user migration.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: two Supabase email templates must be changed to the token_hash form,
# or confirmation and reset links will not work. See README.

# Sign-in-with buttons to show, comma separated. Each must ALSO be enabled in
# Supabase (Authentication > Providers) or the button leads to an error.
# Supported: google, discord, github, gitlab, azure, apple, twitch
SUPABASE_OAUTH_PROVIDERS=google,discord

# --- Admin --------------------------------------------------------------
# Bootstraps the first administrator. Afterwards use:
#   flask create-admin --email you@example.com --password '...'
ADMIN_EMAIL=admin@fluxservers.cloud
ADMIN_PASSWORD=

# --- Game panel (FluidPanel) ---------------------------------------------
# FluidPanel is the only panel this application talks to. It is a Pterodactyl
# fork and keeps the same application/client API.
# FLUID_* is preferred. PANEL_*, PTERODACTYL_* and PELICAN_* are still read, in
# that order, so an existing .env keeps working without edits.
FLUID_URL=https://panel.example.com

# Application key: panel-wide admin. Creates, suspends and deletes servers for
# every customer. Server-side only — it must never reach a browser.
FLUID_API_KEY=

# Client key: acts as a single panel user. Powers live stats, the console, and
# power actions. Without it those features are off but provisioning still works.

# --- Payments -----------------------------------------------------------
# Both providers must agree about live vs test, or the app refuses to start.

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Required in production. Without it payments cannot be confirmed and nothing
# is ever provisioned. Get it from:
#   stripe listen --forward-to localhost:27003/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Optional unless your Stripe account has Managed Payments enabled. In that
# mode, Checkout Sessions that create products inline must include a tax code.
# Set this to an eligible Stripe tax code for your hosting/service product.
STRIPE_PRODUCT_TAX_CODE=txcd_10010001
# Optional override. Managed Payments currently requires 2025-03-31.basil or
# newer, so the app defaults to that API version when this is unset.
STRIPE_API_VERSION=2025-03-31.basil
# Customer-paid gateway fees. Confirm the exact rate for your merchant account.
STRIPE_FEE_PERCENT=2.9
STRIPE_FEE_FIXED_CENTS=30

PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
# live | sandbox
PAYPAL_ENV=sandbox
# Required in production so captures can be verified as payable to you.
# Find it in the PayPal dashboard under Account Settings > Business information.
PAYPAL_MERCHANT_ID=
PAYPAL_FEE_PERCENT=3.49
PAYPAL_FEE_FIXED_CENTS=49

# --- Email --------------------------------------------------------------
# Optional. Needed only when the Flask app itself should send email.
# Supabase Auth confirmation and password-reset emails use Supabase's SMTP
# settings instead, so these can be left empty for a Supabase-only auth setup.
# When unset in local development, the local backend logs emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@fluxservers.cloud

# --- Scheduled jobs -----------------------------------------------------
# Authenticates the /jobs/sync-servers cron endpoint. Without it, servers
# never expire, suspend, or get deleted. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# --- Rate limiting ------------------------------------------------------
# Strongly recommended in production. Without it, limits live in per-instance
# memory and are not shared across serverless instances.
REDIS_URL=

# --- Tunables -----------------------------------------------------------
EXPIRY_DAYS=30
DELETION_GRACE_DAYS=7

# Never set this to true in production: it enables the Werkzeug debugger,
# which is remote code execution.
FLASK_DEBUG=false
