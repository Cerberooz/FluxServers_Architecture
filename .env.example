# Values used by the root compose.yaml for the Panel MariaDB service.
# The Panel's application settings remain in FluxPanel/.env.
PANEL_DB_DATABASE=panel
PANEL_DB_USERNAME=panel
PANEL_DB_PASSWORD=replace_with_the_existing_panel_db_password
PANEL_MYSQL_ROOT_PASSWORD=replace_with_the_existing_mariadb_root_password

# How often FluxWeb synchronizes expiry/suspension state with FluidPanel.
WEB_SYNC_INTERVAL=300
